# Root .gitignore

# Terraform
cloudhost/.env
cloudhost/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
tfplan
*.tfplan

# Secrets & Keys
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Maven binary installation (large binary, not source code)
bin/apache-maven-*/

# Terraform binary
bin/terraform
