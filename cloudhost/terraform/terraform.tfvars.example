# ==============================================================================
# CloudHost - Terraform Variable Definitions Example
# Copy this file to 'terraform.tfvars' and adapt for your environment:
#   cp terraform.tfvars.example terraform.tfvars
# ==============================================================================

# AWS Region where resources will be provisioned
aws_region = "us-east-1"

# Environment tag and identifier (dev, lab, staging)
environment = "lab"

# Naming prefix for resources
project_name = "cloudhost"

# Networking Configuration
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidr   = "10.0.1.0/24"
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]

# IMPORTANT SECURITY SETTING:
# Replace with your actual public workstation IP address (e.g. check at https://checkip.amazonaws.com)
# Example: "203.0.113.45/32"
# DO NOT use "0.0.0.0/0"
admin_ip = "127.0.0.1/32"

# EC2 Compute Options
ec2_instance_type = "t3.micro"
# Optional: Specify name of an existing EC2 Key Pair created in your AWS region
# If left empty (""), you can still access the server via AWS Systems Manager Session Manager
ec2_key_name = ""

# RDS Database Configuration
db_instance_class          = "db.t3.micro"
db_name                    = "cloudhost_db"
db_username                = "cloudhost_admin"
db_allocated_storage       = 20
db_backup_retention_period = 0 # 0 disables automatic backup retention to save cost in lab accounts
enable_deletion_protection = false # Set to false to allow easy destruction via terraform destroy

# S3 Storage Configuration
s3_bucket_prefix = "cloudhost-storage"
